# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT & Auth configuration
JWT_SECRET_KEY=change-this-in-production-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_EMAIL_DOMAIN=hadirin.local

# Password bersama untuk login dosen (POST /auth/dosen/login).
# Jika dikosongkan dan dosen belum terhubung ke Supabase Auth, login dosen dimatikan (503).
DOSEN_DEFAULT_PASSWORD=

# Masa berlaku QR presensi dinamis, dalam detik.
QR_TOKEN_TTL_SECONDS=30

# Attendance GPS geofence (Polinema Malang coordinates / Area Kampus)
GEOFENCE_NAME=Area Kampus Polinema
CAMPUS_LATITUDE=-7.946714
CAMPUS_LONGITUDE=112.615668
MAX_GPS_DISTANCE_METERS=200
GEOFENCE_MAX_ACCURACY_METERS=100

# Face Recognition ML configuration
FACE_SIMILARITY_THRESHOLD=0.5
MTCNN_MIN_FACE_SIZE=20
FACE_MIN_SAMPLES_RECOMMENDED=3
FACE_MAX_SAMPLES_PER_REQUEST=10

# Supabase Storage bucket names
STORAGE_BUCKET_WAJAH=foto-wajah
STORAGE_BUCKET_PRESENSI=foto-presensi
STORAGE_BUCKET_PENGAJUAN=dokumen-pengajuan

# CORS origins (comma-separated, or * for local development)
CORS_ALLOW_ORIGINS=*
