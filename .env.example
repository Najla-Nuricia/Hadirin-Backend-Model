# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Password bersama untuk login dosen (POST /auth/dosen/login).
# Jika dikosongkan, login dosen dimatikan (503).
DOSEN_DEFAULT_PASSWORD=

# Masa berlaku QR presensi dinamis, dalam detik.
QR_TOKEN_TTL_SECONDS=30

# Geofence presensi GPS. Isi dengan titik dan radius area kampus.
GEOFENCE_NAME=Area Kampus
GEOFENCE_LATITUDE=-6.2
GEOFENCE_LONGITUDE=106.8167
GEOFENCE_RADIUS_METERS=200
# Presensi ditolak jika akurasi GPS perangkat lebih buruk dari nilai ini (meter).
GEOFENCE_MAX_ACCURACY_METERS=100
