# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT & Auth configuration
JWT_SECRET_KEY=change-this-in-production-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_EMAIL_DOMAIN=hadirin.local

# Semua peran (mahasiswa/dosen/admin) diverifikasi lewat Supabase Auth.
# JWT aplikasi ditandatangani dengan JWT_SECRET_KEY di atas.

# Admin: identifier login dipetakan ke email Supabase Auth.
ADMIN_USERNAME=adminhadirin
ADMIN_EMAIL=admin@hadirin.polinema.ac.id
# Dipakai hanya oleh scripts/seed_auth_all_roles.py saat provisioning.
ADMIN_INITIAL_PASSWORD=admin123

# Dipakai hanya oleh scripts/seed_auth_all_roles.py saat provisioning dosen.
DOSEN_INITIAL_PASSWORD=dosen123

# Masa berlaku QR presensi dinamis, dalam detik.
QR_TOKEN_TTL_SECONDS=30

# Attendance GPS geofence (Polinema Malang coordinates / Area Kampus)
GEOFENCE_NAME=Area Kampus Polinema
CAMPUS_LATITUDE=-7.9440069
CAMPUS_LONGITUDE=112.6145444
MAX_GPS_DISTANCE_METERS=200
GEOFENCE_MAX_ACCURACY_METERS=100

# Face Recognition ML configuration
FACE_SIMILARITY_THRESHOLD=0.5
# average = centroid semua embedding (default), multiple = max cosine per embedding.
FACE_MATCH_STRATEGY=average
MTCNN_MIN_FACE_SIZE=20
FACE_MIN_SAMPLES_RECOMMENDED=3
FACE_MAX_SAMPLES_PER_REQUEST=10

# Supabase Storage buckets (foto wajah/presensi tidak lagi disimpan)
STORAGE_BUCKET_PENGAJUAN=dokumen-pengajuan

# Testing / Development — jangan aktifkan di produksi
# TESTING_BYPASS_SESSION=true
# TESTING_BYPASS_LOCATION=true

# CORS origins (comma-separated, or * for local development)
CORS_ALLOW_ORIGINS=*
